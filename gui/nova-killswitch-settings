#!/usr/bin/env python3
"""nova-killswitch-settings — GTK4/libadwaita front-end for nova-killswitchd.

Talks to the root daemon over the D-Bus system bus (org.novanetwork.KillSwitch).
No pkexec, no polkit prompts — the daemon's bus policy authorizes the wheel
group, so everything here is passwordless.
"""
import signal

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib, Gio  # noqa: E402

APP_ID = "org.novanetwork.NovaKillSwitch"
DEST = "org.novanetwork.KillSwitch"
OBJ = "/org/novanetwork/KillSwitch"


class Daemon:
    """Thin synchronous D-Bus client for nova-killswitchd."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def _call(self, method, variant=None, reply=None):
        return self.bus.call_sync(DEST, OBJ, DEST, method, variant, reply,
                                  Gio.DBusCallFlags.NONE, 8000, None)

    def available(self):
        try:
            self._call("GetStatus", None, GLib.VariantType("(a{sv})"))
            return True
        except GLib.Error:
            return False

    def status(self):
        r = self._call("GetStatus", None, GLib.VariantType("(a{sv})"))
        return {k: v for k, v in r.unpack()[0].items()}

    def config(self):
        r = self._call("GetConfig", None, GLib.VariantType("(a{ss})"))
        return r.unpack()[0]

    def set_config(self, key, value):
        self._call("SetConfig", GLib.Variant("(ss)", (key, str(value))))

    def list_vpns(self):
        r = self._call("ListVpns", None, GLib.VariantType("(a(sss))"))
        return r.unpack()[0]

    def list_profiles(self):
        return self._call("ListProfiles", None, GLib.VariantType("(as)")).unpack()[0]

    def get_profile(self, name):
        return self._call("GetProfile", GLib.Variant("(s)", (name,)),
                          GLib.VariantType("(as)")).unpack()[0]

    def write_profile(self, name, layers):
        self._call("WriteProfile", GLib.Variant("(sas)", (name, layers)))

    def delete_profile(self, name):
        self._call("DeleteProfile", GLib.Variant("(s)", (name,)))

    def arm(self, profile=""):
        self._call("Arm", GLib.Variant("(s)", (profile,)))

    def disarm(self):
        self._call("Disarm")

    def watch(self, cb):
        self.bus.signal_subscribe(DEST, DEST, "Changed", OBJ, None,
                                  Gio.DBusSignalFlags.NONE, lambda *_: cb())


class Window(Adw.ApplicationWindow):
    def __init__(self, app, daemon):
        super().__init__(application=app, title="Nova Kill Switch")
        self.set_default_size(640, 820)
        self.d = daemon
        self._loading = False
        self._vpns = []
        self._profiles = []

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Nova Kill Switch",
                                                subtitle="VPN protection"))
        self.toasts = Adw.ToastOverlay()
        page = Adw.PreferencesPage()
        self._build_status(page)
        self._build_mode(page)
        self._build_full(page)
        self._build_node(page)
        self._build_mgmt(page)
        self.toasts.set_child(Gtk.ScrolledWindow(child=page, vexpand=True))
        view = Adw.ToolbarView(content=self.toasts)
        view.add_top_bar(header)
        self.set_content(view)

        self.d.watch(lambda: GLib.idle_add(self.reload))
        self.reload()

    # ---- groups ----
    def _build_status(self, page):
        grp = Adw.PreferencesGroup()
        self.arm_row = Adw.SwitchRow(title="Protection", subtitle="Arm the kill switch")
        self.arm_row.connect("notify::active", self._on_arm)
        grp.add(self.arm_row)
        page.add(grp)

    def _build_mode(self, page):
        grp = Adw.PreferencesGroup(title="Mode")
        self.mode = Adw.ComboRow(title="Protection mode")
        self.mode.set_model(Gtk.StringList.new([
            "Full kill switch  —  route everything through the VPN chain",
            "Node access  —  prefer the local nova-node, VPN only if needed"]))
        self.mode.connect("notify::selected", self._on_mode)
        grp.add(self.mode)
        self.manage = Adw.SwitchRow(title="Manage tunnels automatically",
                                    subtitle="Arming brings the VPN(s) up in order; disarming stops them")
        self.manage.connect("notify::active", lambda *_: self._loading or
                            self._set("manage_tunnels", self.manage.get_active()))
        grp.add(self.manage)
        self.auto_arm = Adw.SwitchRow(title="Auto-arm on VPN up",
                                      subtitle="When you connect a VPN yourself, arm around it "
                                               "(stays armed if it drops)")
        self.auto_arm.connect("notify::active", lambda *_: self._loading or
                             self._set("auto_arm", self.auto_arm.get_active()))
        grp.add(self.auto_arm)
        page.add(grp)

    def _build_full(self, page):
        self.full_profiles = Adw.PreferencesGroup(
            title="VPN Chains",
            description="Ordered tunnels. Layer 1 is the base; each below routes through the one above.")
        add = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER, tooltip_text="New chain")
        add.add_css_class("flat")
        add.connect("clicked", lambda *_: self._edit_profile(None))
        self.full_profiles.set_header_suffix(add)
        page.add(self.full_profiles)

        self.full_opts = Adw.PreferencesGroup(title="Full-mode Options")
        self.default_profile = Adw.ComboRow(title="Default chain", subtitle="Armed when you flip the switch")
        self.default_profile.connect("notify::selected", self._on_default_profile)
        self.full_opts.add(self.default_profile)
        self.bypass = Adw.EntryRow(title="Bypass subnets (always allowed)")
        self.bypass.set_show_apply_button(True)
        self.bypass.connect("apply", lambda *_: self._set("bypass_subnets", self.bypass.get_text()))
        self.full_opts.add(self.bypass)
        page.add(self.full_opts)

        self.full_gw = Adw.PreferencesGroup(
            title="Trusted Gateways",
            description="Your nova-nodes / VPN routers (IP/MAC). On these networks the chain can be skipped.")
        self.gateways = Adw.EntryRow(title="IP/MAC list")
        self.gateways.set_show_apply_button(True)
        self.gateways.connect("apply", lambda *_: self._set("trusted_gateways", self.gateways.get_text()))
        self.full_gw.add(self.gateways)
        page.add(self.full_gw)

    def _build_node(self, page):
        self.node_grp = Adw.PreferencesGroup(
            title="Nova-Node",
            description="Preferred on the LAN; if unreachable there, the split VPN below is used. "
                        "DNS is forced to the node, blocked if neither path works.")
        self.node_local = Adw.EntryRow(title="Node LAN address")
        self.node_local.set_show_apply_button(True)
        self.node_local.connect("apply", lambda *_: self._set("node_local", self.node_local.get_text()))
        self.node_grp.add(self.node_local)
        self.node_vpn = Adw.EntryRow(title="Node VPN address")
        self.node_vpn.set_show_apply_button(True)
        self.node_vpn.connect("apply", lambda *_: self._set("node_vpn", self.node_vpn.get_text()))
        self.node_grp.add(self.node_vpn)
        self.node_tunnel = Adw.ComboRow(title="Split VPN to the node",
                                        subtitle="Brought up only when the LAN node is unreachable")
        self.node_tunnel.connect("notify::selected", self._on_node_tunnel)
        self.node_grp.add(self.node_tunnel)
        page.add(self.node_grp)

    def _build_mgmt(self, page):
        grp = Adw.PreferencesGroup(title="Stay Reachable",
                                   description="So arming can never lock you out of this machine.")
        self.allow_ports = Adw.EntryRow(title="Keep these inbound ports open")
        self.allow_ports.set_show_apply_button(True)
        self.allow_ports.connect("apply", lambda *_: self._set("allow_in_ports", self.allow_ports.get_text()))
        grp.add(self.allow_ports)
        self.mgmt_subnets = Adw.EntryRow(title="Management subnets")
        self.mgmt_subnets.set_show_apply_button(True)
        self.mgmt_subnets.connect("apply", lambda *_: self._set("mgmt_subnets", self.mgmt_subnets.get_text()))
        grp.add(self.mgmt_subnets)
        page.add(grp)

    # ---- data ----
    def reload(self):
        self._loading = True
        try:
            st = self.d.status()
            cfg = self.d.config()
        except GLib.Error as e:
            self.toast(f"daemon unreachable: {e.message}")
            self._loading = False
            return False
        armed = bool(st.get("armed"))
        self.arm_row.set_active(armed)
        self.arm_row.set_subtitle(str(st.get("detail", "")).capitalize() if armed else "Disarmed")

        is_node = cfg.get("mode", "full") in ("node", "dns")
        self.mode.set_selected(1 if is_node else 0)
        self.manage.set_active(cfg.get("manage_tunnels") == "1")
        self.auto_arm.set_active(cfg.get("auto_arm") == "1")
        self.bypass.set_text(cfg.get("bypass_subnets", ""))
        self.gateways.set_text(cfg.get("trusted_gateways", ""))
        self.node_local.set_text(cfg.get("node_local", ""))
        self.node_vpn.set_text(cfg.get("node_vpn", ""))
        self.allow_ports.set_text(cfg.get("allow_in_ports", "22"))
        self.mgmt_subnets.set_text(cfg.get("mgmt_subnets", ""))

        self._reload_vpns(cfg.get("node_tunnel", ""))
        self._reload_profiles(cfg.get("default_profile", ""))
        self._vis(is_node)
        self._loading = False
        return False

    def _vis(self, is_node):
        self.full_profiles.set_visible(not is_node)
        self.full_opts.set_visible(not is_node)
        self.full_gw.set_visible(not is_node)
        self.node_grp.set_visible(is_node)

    def _reload_vpns(self, want):
        self._vpns = list(self.d.list_vpns())
        names = ["(none)"] + [n for n, _, _ in self._vpns]
        self.node_tunnel.set_model(Gtk.StringList.new(names))
        self.node_tunnel.set_selected(names.index(want) if want in names else 0)

    def _reload_profiles(self, default):
        self._profiles = list(self.d.list_profiles())
        for row in getattr(self, "_prows", []):
            self.full_profiles.remove(row)
        self._prows = []
        if not self._profiles:
            r = Adw.ActionRow(title="No chains yet", subtitle="Use + to build one from your VPN connections")
            self.full_profiles.add(r); self._prows.append(r)
        for name in self._profiles:
            row = Adw.ActionRow(title=name)
            edit = Gtk.Button(icon_name="document-edit-symbolic", valign=Gtk.Align.CENTER); edit.add_css_class("flat")
            edit.connect("clicked", lambda _b, n=name: self._edit_profile(n))
            dele = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER)
            dele.add_css_class("flat"); dele.add_css_class("error")
            dele.connect("clicked", lambda _b, n=name: (self.d.delete_profile(n), self.reload()))
            row.add_suffix(edit); row.add_suffix(dele)
            self.full_profiles.add(row); self._prows.append(row)
        names = ["(none)"] + self._profiles
        self.default_profile.set_model(Gtk.StringList.new(names))
        self.default_profile.set_selected(names.index(default) if default in names else 0)

    # ---- actions ----
    def _set(self, key, value):
        try:
            self.d.set_config(key, "1" if value is True else "0" if value is False else value)
            self.toast("Saved")
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")

    def _on_mode(self, *_):
        if not self._loading:
            self._set("mode", "node" if self.mode.get_selected() == 1 else "full")
            self._vis(self.mode.get_selected() == 1)

    def _on_default_profile(self, *_):
        if self._loading:
            return
        i = self.default_profile.get_selected()
        self._set("default_profile", "" if i == 0 else self._profiles[i - 1])

    def _on_node_tunnel(self, *_):
        if self._loading:
            return
        i = self.node_tunnel.get_selected()
        self._set("node_tunnel", "" if i == 0 else self._vpns[i - 1][0])

    def _on_arm(self, *_):
        if self._loading:
            return
        try:
            self.d.arm() if self.arm_row.get_active() else self.d.disarm()
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        self.reload()

    def _edit_profile(self, name):
        dlg = Adw.Window(title=("Edit " + name) if name else "New chain",
                         transient_for=self, modal=True)
        dlg.set_default_size(500, 560)
        tb = Adw.ToolbarView(); h = Adw.HeaderBar()
        name_entry = Gtk.Entry(placeholder_text="chain name", text=name or "",
                               sensitive=name is None, hexpand=True, valign=Gtk.Align.CENTER)
        h.set_title_widget(name_entry)
        save = Gtk.Button(label="Save"); save.add_css_class("suggested-action"); h.pack_end(save)
        tb.add_top_bar(h)

        existing = list(self.d.get_profile(name)) if name else []
        vt = {n: t for n, t, _ in self._vpns}
        va = {n: a for n, _, a in self._vpns}
        ordered = [n for n in existing if n in vt] + [n for n, _, _ in self._vpns if n not in existing]
        ordered += [n for n in existing if n not in vt]

        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE); lb.add_css_class("boxed-list")
        rows = []

        def renumber():
            pos = 0
            for r in rows:
                if r._c.get_active():
                    pos += 1; r.set_title(f"{pos}.  {r._n}")
                else:
                    r.set_title(r._n)

        def move(r, d):
            i = rows.index(r); j = i + d
            if 0 <= j < len(rows):
                rows[i], rows[j] = rows[j], rows[i]; lb.remove(r); lb.insert(r, j); renumber()

        for conn in ordered:
            row = Adw.ActionRow(title=conn); row._n = conn
            row.set_subtitle(vt.get(conn, "missing") + ("  · active" if va.get(conn) == "yes" else ""))
            c = Gtk.CheckButton(valign=Gtk.Align.CENTER, active=(conn in existing)); row._c = c
            c.connect("toggled", lambda *_: renumber()); row.add_prefix(c)
            up = Gtk.Button(icon_name="go-up-symbolic", valign=Gtk.Align.CENTER); up.add_css_class("flat")
            up.connect("clicked", lambda _b, r=row: move(r, -1))
            dn = Gtk.Button(icon_name="go-down-symbolic", valign=Gtk.Align.CENTER); dn.add_css_class("flat")
            dn.connect("clicked", lambda _b, r=row: move(r, +1))
            row.add_suffix(up); row.add_suffix(dn)
            lb.append(row); rows.append(row)
        renumber()

        hint = Gtk.Label(label="Tick the tunnels in this chain and order them: layer 1 (top) is the base; "
                               "each below routes through the one above.",
                         wrap=True, xalign=0, margin_top=6, margin_bottom=6)
        hint.add_css_class("dim-label"); hint.add_css_class("caption")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        box.append(hint)
        box.append(lb if self._vpns else Adw.StatusPage(
            icon_name="network-vpn-symbolic", title="No VPN connections",
            description="Create WireGuard/OpenVPN connections in GNOME Settings → Network first."))
        tb.set_content(Gtk.ScrolledWindow(child=box, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        dlg.set_content(tb)

        def do_save(*_):
            pn = name_entry.get_text().strip()
            if not pn:
                self.toast("Name required"); return
            layers = [r._n for r in rows if r._c.get_active()]
            try:
                self.d.write_profile(pn, layers); self.toast(f"Saved {pn}")
            except GLib.Error as e:
                self.toast(f"Failed: {e.message}")
            dlg.close(); self.reload()

        save.connect("clicked", do_save)
        dlg.present()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            try:
                d = Daemon()
                if not d.available():
                    raise RuntimeError("nova-killswitchd is not running")
            except Exception as e:  # noqa: BLE001
                dlg = Adw.AlertDialog(heading="Kill switch daemon unavailable",
                                      body=f"{e}\n\nInstall/start it: sudo systemctl enable --now nova-killswitchd")
                dlg.add_response("close", "Close")
                tmp = Adw.ApplicationWindow(application=self)
                dlg.connect("response", lambda *_: self.quit())
                dlg.present(tmp)
                return
            win = Window(self, d)
        win.present()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    raise SystemExit(App().run(None))
