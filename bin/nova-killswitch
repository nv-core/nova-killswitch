#!/usr/bin/env bash
# nova-killswitch — thin terminal client for nova-killswitchd (talks D-Bus).
# Passwordless for wheel users via the daemon's D-Bus policy.
set -euo pipefail
DEST=org.novanetwork.KillSwitch
OBJ=/org/novanetwork/KillSwitch
call() { gdbus call --system -d "$DEST" -o "$OBJ" -m "$DEST.$@"; }

case "${1:-status}" in
    arm)      call Arm "${2:-}" >/dev/null; echo "armed" ;;
    disarm)   call Disarm >/dev/null; echo "disarmed" ;;
    status)   call GetStatus | sed -E "s/^\(|,?\)$//g; s/, '/\n'/g; s/'([a-z_]+)': </\1 = /g; s/>//g" ;;
    config)   call GetConfig ;;
    set)      call SetConfig "${2:?key}" "${3:?value}" >/dev/null; echo "set ${2}=${3}" ;;
    vpns)     call ListVpns ;;
    profiles) call ListProfiles ;;
    *) echo "usage: nova-killswitch {status|arm [chain]|disarm|config|set <k> <v>|vpns|profiles}" >&2; exit 2 ;;
esac
