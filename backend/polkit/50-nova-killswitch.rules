// Passwordless arm/disarm/config for the kill switch. Authorizes pkexec of
// exactly one root-owned, non-user-writable program for active wheel users.
// (We intentionally do NOT require subject.local: VM consoles and some
// desktop sessions report non-local, which was causing password prompts.
// Safe because the target program is root-owned and not user-writable.)
polkit.addRule(function(action, subject) {
    if (!(subject.isInGroup("wheel") && subject.active))
        return;
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/sbin/nova-killswitch-ctl") {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit == "nova-killswitch-monitor.service" ||
            unit == "nova-killswitch-restore.service") {
            return polkit.Result.YES;
        }
    }
});
