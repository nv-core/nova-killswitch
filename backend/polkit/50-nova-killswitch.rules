// Allow local active wheel users to arm/disarm the kill switch and start its
// services WITHOUT a password. Passwordless is safe ONLY because the target
// program (/usr/local/sbin/nova-killswitch-ctl) is root-owned and not
// user-writable — never point this at a writable path or loosen its perms.
polkit.addRule(function(action, subject) {
    if (!(subject.isInGroup("wheel") && subject.local && subject.active))
        return;
    // pkexec of the controller itself (extension/GUI arm-disarm)
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/sbin/nova-killswitch-ctl") {
        return polkit.Result.YES;
    }
    // starting/stopping the kill switch services from the GUI
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit == "nova-killswitch-monitor.service" ||
            unit == "nova-killswitch-restore.service") {
            return polkit.Result.YES;
        }
    }
});
