#!/usr/bin/env bash
# NetworkManager dispatcher: keep the kill switch in sync with connectivity,
# and (if AUTO_ARM=1) arm it automatically when a VPN comes up.
# Installed at /etc/NetworkManager/dispatcher.d/90-nova-killswitch.
# NM calls it as: <script> <interface> <action>
CTL=/usr/local/sbin/nova-killswitch-ctl
STATE_FILE=/etc/nova-killswitch/state
CONFIG=/etc/nova-killswitch/config
[ -x "$CTL" ] || exit 0

IFACE="$1"; ACTION="$2"
AUTO_ARM=0
[ -r "$CONFIG" ] && AUTO_ARM="$(sed -n 's/^AUTO_ARM=//p' "$CONFIG" | tr -d '"' | tail -1)"
armed() { [ "$(cat "$STATE_FILE" 2>/dev/null)" = armed ]; }
is_tunnel() { case "$1" in tun*|tap*|wg*|ppp*|nova*) return 0 ;; *) return 1 ;; esac; }

case "$ACTION" in
    vpn-up)
        # a NetworkManager VPN (OpenVPN etc.) finished connecting
        [ "$AUTO_ARM" = 1 ] && ! armed && "$CTL" auto-arm || { armed && "$CTL" sync; } ;;
    up)
        # a device came up — auto-arm only for tunnel devices (WireGuard)
        if is_tunnel "$IFACE"; then
            [ "$AUTO_ARM" = 1 ] && ! armed && "$CTL" auto-arm || { armed && "$CTL" sync; }
        else
            armed && "$CTL" sync
        fi ;;
    vpn-down|down|connectivity-change|dhcp4-change|dhcp6-change)
        armed && "$CTL" sync ;;   # stay armed (fail-closed); just re-evaluate
esac
exit 0
