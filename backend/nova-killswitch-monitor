#!/usr/bin/env bash
# nova-killswitch-monitor — event-driven re-evaluation of the kill switch.
#
# Runs as a root systemd service. Reacts to link/route/address changes
# instantly via `ip monitor` (so wifi->5G, cable unplug, VPN drop, gateway
# change all re-sync within moments) and re-checks periodically as a
# safety net. Only ever calls `nova-killswitch-ctl sync`, which is a no-op
# unless the switch is armed — zero cost while disarmed.
set -euo pipefail

CTL=/usr/local/sbin/nova-killswitch-ctl
[ -x "$CTL" ] || CTL=/etc/nova-killswitch/nova-killswitch-ctl
STATE_FILE=/etc/nova-killswitch/state
PERIODIC=30

armed() { [ "$(cat "$STATE_FILE" 2>/dev/null)" = armed ]; }
resync() { armed && "$CTL" sync || true; }

resync   # initial

# periodic safety-net loop in the background
( while true; do sleep "$PERIODIC"; resync; done ) &
PERIODIC_PID=$!
trap 'kill "$PERIODIC_PID" 2>/dev/null || true' EXIT

# event stream: any address/route/link change triggers an immediate resync.
# `ip monitor` emits a line per event; debounce bursts with a short settle.
ip monitor link addr route 2>/dev/null | while read -r _; do
    # drain a burst, then act once
    sleep 0.4
    resync
done
