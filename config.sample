# nova-killswitch config — installed to /etc/nova-killswitch/config
# Sourced as shell by the root controller; edited via the GTK app (pkexec).

# Protection mode:
#   full = fail-closed WAN kill switch (block everything except the VPN
#          chain / trusted gateway / bypass subnets)
#   node = prefer the nova-node on the LAN; if it can't be reached there, bring
#          up the split VPN below to reach it over the tunnel. WAN stays
#          direct, you get full access to the node (local or VPN address), DNS
#          is forced to the node, and blocked if the node is unreachable by any
#          path. ("dns" is accepted as an alias.)
MODE=full

# --- node mode ---
# The nova-node's address on the LAN (preferred path). IP or subnet:
NODE_LOCAL=""
# The nova-node's address over the split VPN (used when NODE_LOCAL is down):
NODE_VPN=""
# The split VPN connection (NM name) that reaches the node when off-LAN:
NODE_TUNNEL=""

# Profile armed by default (name of a file in profiles/, without .profile).
# In dns mode a profile can still bring up the split/DNS tunnel; only DNS is
# routed through it, the rest of your traffic stays direct.
# Empty = no VPN chain, only trusted-gateway/bypass rules apply.
DEFAULT_PROFILE=""

# Permit RFC1918 / link-local traffic while armed (1) or block it (0).
ALLOW_LAN=0

# Always-allowed destination CIDRs (space-separated, v4 and v6).
BYPASS_SUBNETS=""

# Auto-allow each active tunnel's own subnet (so in-VPN LAN works). 1/0.
AUTO_BYPASS_VPN_SUBNET=1

# Trusted local gateways = your nova-nodes / VPN routers. Space-separated
# "IP/MAC" pairs. A gateway is trusted only when the current default route's
# IP AND its ARP MAC both match — then its uplink interface is allowed and
# the VPN chain may be skipped. Example:
#   TRUSTED_GATEWAYS="192.168.1.1/aa:bb:cc:dd:ee:ff 10.0.0.1/11:22:33:44:55:66"
TRUSTED_GATEWAYS=""

# Arming a profile also brings its VPN chain up (in order, with inter-layer
# routing) and disarming tears it back down. 0 = firewall only, you manage
# the tunnels yourself.
MANAGE_TUNNELS=1

# Auto-arm: when you bring a VPN up yourself (nmcli/GNOME), arm the kill switch
# around it automatically (firewall only, no tunnel management). It stays armed
# if the VPN later drops (fail-closed) — disarm by hand. 0 = off.
AUTO_ARM=0

# Inbound TCP ports kept reachable while armed so you never lock yourself out
# of the machine (sshd = 22). Space-separated.
ALLOW_IN_PORTS="22"

# Management subnets that must ALWAYS be able to reach this box — e.g. the
# admin LAN you SSH in from. These are firewall-allowed AND policy-routed via
# the main table, so remote access survives even a full-tunnel chain.
#   MGMT_SUBNETS="192.168.2.0/24"
MGMT_SUBNETS=""
